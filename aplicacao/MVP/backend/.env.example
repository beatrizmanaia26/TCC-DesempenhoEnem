PORT=3000
NODE_ENV=development
VITE_API_URL=http://localhost:3000/api

# Python paths - DEVE ser um caminho absoluto (nao relativo)
# Em Linux/Mac: /usr/bin/python3
# Em Windows: C:\Python\python.exe
PYTHON_PATH=/usr/bin/python3

# CORS configuration
# Use * para desenvolvimento, especifique dominio em producao
CORS_ORIGIN=*

# File upload - Maximo 10MB por padrao de seguranca
MAX_FILE_SIZE=10485760

# Analyses directory
ANALYSES_DIR=./analyses

# Database (opcional - para implementacao futura)
# MONGODB_URI=mongodb://localhost:27017/analise-provas
